<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  文件：ReminderPopupWindow.xaml
  用途：极简提醒小窗——内容只有眨眼动画。
        背景使用高度透明的亚克力毛玻璃（代码中通过 DesktopAcrylicController 设置），
        视觉上接近"眼睛浮在屏幕上"，尽量少遮挡用户正在看的内容。
        说明：WinUI 3 / Windows App SDK 1.6 不支持真全透明窗口；
        已在 1.6+Win11 上实测颜色键/分层窗口方案（LWA_COLORKEY），
        结论是 Composition 层不响应颜色键（Win11 DWM 行为差异）。
  ============================================================================
-->
<Window
    x:Class="MingMou.ReminderPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MingMou.Controls"
    Title="明眸提醒">

    <Grid Background="Transparent">
        <controls:BlinkControl
            x:Name="BlinkAnimation"
            Width="168"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Window>
