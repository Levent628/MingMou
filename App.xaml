<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  文件：App.xaml
  用途：应用级资源字典，定义主题色、字体与全局样式
  ============================================================================
-->
<Application
    x:Class="MingMou.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!--
              必须合并 WinUI 默认控件资源，否则 Button / ToggleSwitch 等控件
              会因为找不到默认样式而在运行时抛出异常。
            -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- 浅色主题资源 -->
                <ResourceDictionary x:Key="Light">
                    <!-- 品牌主色 #0A6EFF -->
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0A6EFF" />
                    <!-- 品牌辅助色 #00B8D4 -->
                    <SolidColorBrush x:Key="BrandAccentBrush" Color="#00B8D4" />
                    <!-- 眼睑填充色：柔和的肤色感，与白色眼睛形成对比 -->
                    <SolidColorBrush x:Key="EyelidBrush" Color="#E8D5D1" />
                    <!-- 眼白填充色 -->
                    <SolidColorBrush x:Key="EyeWhiteBrush" Color="#FFFFFF" />
                    <!-- 瞳孔填充色 -->
                    <SolidColorBrush x:Key="PupilBrush" Color="#082C6B" />
                    <!-- 主窗口标题文本颜色 -->
                    <SolidColorBrush x:Key="TitleTextBrush" Color="#1A1A1A" />
                    <!-- 正文文本颜色 -->
                    <SolidColorBrush x:Key="BodyTextBrush" Color="#2B2B2B" />
                    <!-- 提示语文本颜色 -->
                    <SolidColorBrush x:Key="HintTextBrush" Color="#5A5A5A" />
                    <!-- 卡片背景：半透明白色，让云母背景透出 -->
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#E6FFFFFF" />
                    <!-- 主按钮文字颜色：深蓝底用白字，对比清晰 -->
                    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>

                <!-- 深色主题资源 -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#4C9AFF" />
                    <SolidColorBrush x:Key="BrandAccentBrush" Color="#00E5FF" />
                    <SolidColorBrush x:Key="EyelidBrush" Color="#8A726C" />
                    <SolidColorBrush x:Key="EyeWhiteBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="PupilBrush" Color="#B3D1FF" />
                    <SolidColorBrush x:Key="TitleTextBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="BodyTextBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="HintTextBrush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#E6222222" />
                    <!-- 主按钮文字颜色：亮蓝底用深色字，避免白字对比度不足 -->
                    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#0A2540" />
                </ResourceDictionary>

                <!--
                  高对比度主题：系统开启高对比度时，若缺少该字典会导致 ThemeResource
                  查找失败并抛出异常，因此这里统一映射到系统高对比度画刷。
                -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BrandAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="EyelidBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="EyeWhiteBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PupilBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TitleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BodyTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HintTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 通用按钮样式：透明背景、悬停时显示轻微品牌色 -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{ThemeResource TitleTextBrush}" />
            </Style>

            <!-- 主操作按钮样式：基于 WinUI 默认按钮样式，保留 Win11 的 hover/pressed/阴影反馈，
                 仅覆盖背景与前景色（主题化对比度） -->
            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ButtonPrimaryForegroundBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
